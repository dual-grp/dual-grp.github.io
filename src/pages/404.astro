---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you are looking for does not exist or has moved.">
  <div class="container-x flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="flex items-center justify-center gap-2.5 kicker">
      <span class="crosshair" aria-hidden="true"></span>
      Error — 404
    </p>
    <h1 class="mt-4 text-4xl sm:text-5xl font-semibold tracking-tight">Page not found.</h1>
    <p class="mt-4 max-w-md text-muted leading-relaxed">
      The page you are looking for does not exist or may have moved.
    </p>
    <a href="/" class="btn-primary mt-8">Back to home</a>
  </div>
</Base>
