---
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.astro';
import { SITE } from '../data/site';
---

<Base title="Contact" description="Contact details for the DUAL Group.">
  <div class="container-x py-16 sm:py-24">
    <Reveal>
      <header class="mb-12">
        <p class="flex items-center gap-2.5 kicker">
          <span class="crosshair" aria-hidden="true"></span>
          Contact DUAL
        </p>
        <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight">Start a conversation.</h1>
        <p class="mt-4 text-muted max-w-2xl leading-relaxed">
          We welcome collaboration opportunities, research inquiries, and discussions about distributed
          intelligence, optimization, reliable AI, and efficient learning systems.
        </p>
        <div class="rule mt-10"></div>
      </header>
    </Reveal>

    <Reveal>
      <section
        aria-label="Research inquiries"
        class="card p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6"
      >
        <div>
          <p class="kicker">Research inquiries</p>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight">Let’s discuss the work.</h2>
          <p class="mt-2 text-muted max-w-xl leading-relaxed">
            For questions about collaboration or joining the group, contact PI by email.
          </p>
        </div>
        <a href={`mailto:${SITE.contactEmail}`} class="btn-primary shrink-0 self-start sm:self-center">
          {SITE.contactEmail} <span aria-hidden="true">→</span>
        </a>
      </section>
    </Reveal>

    <section class="mt-16 sm:mt-20" aria-label="Location and office hours">
      <div class="grid gap-4 sm:grid-cols-2">
        <Reveal>
          <article class="card h-full p-6 sm:p-8">
            <p class="kicker">Find us</p>
            <h2 class="mt-2 text-xl font-semibold tracking-tight">School of Computer Science</h2>
            <address class="mt-2 not-italic text-muted leading-relaxed">
              University of Sydney
              <br />
              NSW 2006, Australia
            </address>
            <p class="mt-4">
              <a
                href="https://www.google.com/maps/place/School+of+Computer+Science,+University+of+Sydney"
                target="_blank"
                rel="noopener noreferrer"
                class="link-arrow"
              >
                Open in Google Maps <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </p>
          </article>
        </Reveal>
        <Reveal>
          <article class="card h-full p-6 sm:p-8">
            <p class="kicker">Office hours</p>
            <h2 class="mt-2 text-xl font-semibold tracking-tight">Monday to Friday</h2>
            <p class="mt-2 font-mono text-sm">9:00 AM–5:00 PM</p>
            <p class="mt-2 text-muted leading-relaxed">
              Please email ahead when arranging a research meeting or visit.
            </p>
          </article>
        </Reveal>
      </div>
    </section>

    <section class="mt-16 sm:mt-20" aria-label="DUAL Group and University of Sydney">
      <Reveal>
        <figure>
          <img
            src="/assets/img/lab/campus-building.jpg"
            alt="Modern glass building at the University of Sydney"
            loading="lazy"
            class="w-full aspect-[21/9] rounded-lg border border-line object-cover"
          />
          <figcaption class="mt-2 font-mono text-xs text-muted">
            <span class="text-accent">FIG. 01</span> / School of Computer Science, University of Sydney
          </figcaption>
        </figure>
      </Reveal>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <Reveal>
          <figure>
            <img
              src="/assets/img/lab/lab_cropped.jpg"
              alt="DUAL Group research lab"
              loading="lazy"
              class="w-full aspect-[16/9] rounded-lg border border-line object-cover"
            />
            <figcaption class="mt-2 font-mono text-xs text-muted">
              <span class="text-accent">FIG. 02</span> / DUAL research environment
            </figcaption>
          </figure>
        </Reveal>
        <Reveal>
          <figure>
            <img
              src="/assets/img/lab/campus_cropped.jpg"
              alt="University of Sydney campus"
              loading="lazy"
              class="w-full aspect-[16/9] rounded-lg border border-line object-cover"
            />
            <figcaption class="mt-2 font-mono text-xs text-muted">
              <span class="text-accent">FIG. 03</span> / University of Sydney campus
            </figcaption>
          </figure>
        </Reveal>
      </div>
    </section>
  </div>
</Base>
