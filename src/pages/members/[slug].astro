---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Reveal from '../../components/Reveal.astro';
import { ROLE_LABELS } from '../../data/site';
import { resolveMemberImage, resolveMemberLinks } from '../../utils/members';

export async function getStaticPaths() {
  const members = await getCollection('members');
  return members.map((member) => ({
    params: { slug: member.id },
    props: { member },
  }));
}

interface Props {
  member: CollectionEntry<'members'>;
}

const { member } = Astro.props;
const { name, role, description, image } = member.data;
const { Content } = await render(member);

const roleLabel = ROLE_LABELS[role] ?? role;
const portrait = resolveMemberImage(image);
const links = resolveMemberLinks(member.data.links);
---

<Base title={name} description={description}>
  <article class="container-x py-14 sm:py-20">
    <a href="/people/" class="font-mono text-sm text-muted hover:text-accent transition-colors">
      &larr; All people
    </a>

    <Reveal>
      <div
        class:list={[
          'mt-10 grid items-start gap-10 md:gap-14',
          portrait && 'md:grid-cols-[auto_1fr]',
        ]}
      >
        {
          portrait && (
            <div class="card overflow-hidden w-full max-w-xs">
              <img
                src={portrait}
                alt={`Portrait of ${name}`}
                class="aspect-[4/5] w-full object-cover"
              />
            </div>
          )
        }

        <div>
          <p class="kicker">{roleLabel}</p>
          <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight">{name}</h1>
          {description && <p class="mt-5 max-w-xl text-muted leading-relaxed">{description}</p>}

          {
            links.length > 0 && (
              <ul class="mt-7 flex flex-wrap gap-3">
                {links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="btn-ghost"
                      {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      {link.label}
                      {link.external && (
                        <>
                          <span aria-hidden="true">↗</span>
                          <span class="sr-only">(opens in new tab)</span>
                        </>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </Reveal>

    <div class="mt-14 mb-10 flex items-center gap-3">
      <span class="kicker">Biography</span>
      <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
    </div>
    <div class="prose-dual">
      <Content />
    </div>
  </article>
</Base>
