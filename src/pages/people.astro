---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import Reveal from '../components/Reveal.astro';
import { ROLE_LABELS, ROLE_ORDER } from '../data/site';
import { compareMembersByName } from '../utils/members';

const members = await getCollection('members');

const groups = ROLE_ORDER.map((role) => ({
  role,
  label: ROLE_LABELS[role] ?? role,
  members: members
    .filter((member) => member.data.role === role)
    .sort(compareMembersByName),
})).filter((group) => group.members.length > 0);
---

<Base
  title="People"
  description="The people behind DUAL — researchers and students at the School of Computer Science, University of Sydney."
>
  <div class="container-x py-16 sm:py-24">
    <header class="max-w-2xl">
      <p class="flex items-center gap-2.5 kicker">
        <span class="crosshair" aria-hidden="true"></span>
        The lab
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight">The people.</h1>
      <p class="mt-5 text-lg text-muted leading-relaxed">
        Members of the DUAL Group at the University of Sydney.
      </p>
    </header>

    <div class="mt-16 sm:mt-20 space-y-16 sm:space-y-20">
      {
        groups.map((group) => {
          const featured = group.role === 'professor';
          return (
            <section aria-labelledby={`people-${group.role}`}>
              <Reveal>
                <div class="mb-8 flex items-baseline gap-3">
                  <h2
                    id={`people-${group.role}`}
                    class="font-mono text-lg font-medium tracking-tight"
                  >
                    {group.label}
                  </h2>
                  <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
                  <span class="font-mono text-xs text-muted">
                    / {group.members.length}
                  </span>
                </div>
              </Reveal>

              {
                featured ? (
                  group.members.map((member) => <PersonCard member={member} featured />)
                ) : (
                  <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-4">
                    {group.members.map((member) => (
                      <PersonCard member={member} />
                    ))}
                  </div>
                )
              }
            </section>
          );
        })
      }
    </div>

    <section class="mt-24" aria-labelledby="people-connect">
      <Reveal>
        <div class="rule" />
        <div class="mt-10 flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="kicker">Contact</p>
            <h2 id="people-connect" class="mt-3 text-2xl sm:text-3xl font-semibold tracking-tight">
              Connect with the group.
            </h2>
            <p class="mt-3 max-w-xl text-muted leading-relaxed">
              Learn more about our research or get in touch to start a conversation.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="/research/" class="btn-primary">Explore research</a>
            <a href="/contact/" class="btn-ghost">Contact DUAL</a>
          </div>
        </div>
      </Reveal>
    </section>
  </div>
</Base>
