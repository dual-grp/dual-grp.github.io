---
import Base from '../layouts/Base.astro';
---

<Base title="Research" description="The DUAL Group's repositories have moved to the Research page.">
  <meta slot="head" http-equiv="refresh" content="0; url=/research/" />
  <div class="container-x py-16 sm:py-24">
    <header class="max-w-2xl">
      <p class="flex items-center gap-2.5 kicker">
        <span class="crosshair" aria-hidden="true"></span>
        Moved
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight">
        Repositories now live under Research.
      </h1>
      <p class="mt-5 text-lg text-muted leading-relaxed">
        The research work index links out to code where a repository exists. The group organization
        is on GitHub.
      </p>
      <p class="mt-8">
        <a href="/research/" class="link-arrow">Go to Research <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </header>
  </div>
</Base>
