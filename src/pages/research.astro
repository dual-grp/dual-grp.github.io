---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BorderBeam from '../components/BorderBeam.astro';
import OrbStatus from '../components/OrbStatus.astro';
import Reveal from '../components/Reveal.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE } from '../data/site';

const works = await getCollection('works');

const byYear = new Map<number, typeof works>();
for (const entry of works) {
  const group = byYear.get(entry.data.year);
  if (group) group.push(entry);
  else byYear.set(entry.data.year, [entry]);
}

const yearGroups = [...byYear.entries()]
  .sort(([yearA], [yearB]) => yearB - yearA)
  .map(([year, entries]) => ({
    year,
    entries: entries.sort((a, b) => a.data.title.localeCompare(b.data.title)),
  }));

const totalWorks = works.length;
---

<Base
  title="Research"
  description="Research work from the DUAL Group — conference papers, journal articles, and preprints from the Distributed compUting, optimizAtion, and Learning Group at the University of Sydney."
>
  <div class="container-x py-16 sm:py-24">
    <header class="max-w-2xl">
      <p class="flex items-center gap-2.5 kicker">
        <span class="crosshair" aria-hidden="true"></span>
        Research work
      </p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight">The work.</h1>
      <p class="mt-5 text-lg text-muted leading-relaxed">
        Research from the DUAL Group.
      </p>
      <p class="mt-4 font-mono text-xs text-muted">
        Code lives on
        <a
          href={`https://github.com/${SITE.githubOrg}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:underline underline-offset-4"
        >
          github.com/{SITE.githubOrg} ↗
        </a>
      </p>
    </header>

    <Reveal class="mt-12">
      <BorderBeam trigger="focus">
        <div class="border border-line rounded-lg bg-bg-elev/40 p-5 sm:p-6">
          <div class="flex flex-col gap-5 lg:flex-row lg:items-center">
            <div class="flex-1">
              <label for="work-filter" class="sr-only">Search research work</label>
              <input
                id="work-filter"
                type="search"
                autocomplete="off"
                spellcheck="false"
                placeholder="grep titles, authors, venues…"
                class="w-full bg-transparent border-b border-line focus:border-accent py-2 font-mono text-sm placeholder:text-muted transition-colors"
              />
            </div>
            <OrbStatus label={`${totalWorks} indexed`} />
          </div>

          <div class="mt-5 flex flex-wrap items-center gap-2">
            <button type="button" data-kind-chip data-kind="all" class="chip is-active" aria-pressed="true">
              all
            </button>
            <button type="button" data-kind-chip data-kind="conference" class="chip" aria-pressed="false">
              Conference
            </button>
            <button type="button" data-kind-chip data-kind="journal" class="chip" aria-pressed="false">
              Journal
            </button>
            <button type="button" data-kind-chip data-kind="arxiv" class="chip" aria-pressed="false">
              arXiv
            </button>
            <span class="mx-2 h-4 w-px bg-line" aria-hidden="true"></span>
            <button type="button" data-hot-chip class="chip" aria-pressed="false">hot</button>
          </div>
        </div>
      </BorderBeam>
    </Reveal>

    <div id="work-list" class="mt-16 sm:mt-20">
      {
        yearGroups.map(({ year, entries }) => (
          <section class="mb-12" data-year-group>
            <div class="mb-4 flex items-baseline gap-3">
              <h2 class="font-mono text-lg font-medium tracking-tight">{year}</h2>
              <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
              <span class="font-mono text-xs text-muted">
                / {entries.length} {entries.length === 1 ? 'item' : 'items'}
              </span>
            </div>
            <div class="border-b border-line">
              {entries.map((entry) => (
                <WorkCard entry={entry} />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <div id="work-empty" class="hidden mt-16">
      <div class="rule pt-10 flex flex-col items-center gap-5 text-center">
        <pre class="font-mono text-xs leading-relaxed text-muted select-none" aria-hidden="true">{`┌─────────────────────────┐
│  ∅  nothing in index    │
└─────────────────────────┘`}</pre>
        <p class="font-mono text-sm text-muted">no matches — try fewer terms.</p>
        <button type="button" id="work-reset" class="btn-ghost">Reset filters</button>
      </div>
    </div>
  </div>
</Base>

<script>
  // Unified client-side filter over the server-rendered index. The page works
  // fully without JS; this only hides/shows what is already rendered.
  const input = document.getElementById('work-filter') as HTMLInputElement | null;
  const orbStatus = document.querySelector<HTMLElement>('[data-orb-status]');
  const orbText = orbStatus?.querySelector<HTMLElement>('[data-orb-text]');
  const beamWrap = input?.closest('.border-beam-wrap');
  const list = document.getElementById('work-list');
  const empty = document.getElementById('work-empty');
  const reset = document.getElementById('work-reset');

  const kindChips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-kind-chip]'));
  const hotChip = document.querySelector<HTMLButtonElement>('[data-hot-chip]');

  let kind = 'all';
  let hotOnly = false;

  if (input && list) {
    const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-work-entry]'));
    const total = entries.length;

    const apply = () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      for (const entry of entries) {
        const entryKind = entry.dataset.kind ?? '';
        const haystack = entry.dataset.search ?? '';
        let show = true;

        if (kind !== 'all' && entryKind !== kind) show = false;
        if (hotOnly && entry.dataset.hot !== 'true') show = false;
        if (show && query !== '' && !haystack.includes(query)) show = false;

        entry.classList.toggle('hidden', !show);
        if (show) visible += 1;
      }

      for (const group of Array.from(list.querySelectorAll<HTMLElement>('[data-year-group]'))) {
        group.classList.toggle('hidden', group.querySelector('[data-work-entry]:not(.hidden)') === null);
      }

      const filtering = query !== '' || kind !== 'all' || hotOnly;
      beamWrap?.classList.toggle('is-beaming', filtering);
      if (orbStatus) orbStatus.dataset.mode = filtering ? 'orbits' : 'globe';
      if (orbText) orbText.textContent = `${visible} / ${total} indexed`;
      empty?.classList.toggle('hidden', visible !== 0);
    };

    for (const chip of kindChips) {
      chip.addEventListener('click', () => {
        kind = chip.dataset.kind ?? 'all';
        for (const other of kindChips) {
          const active = other === chip;
          other.classList.toggle('is-active', active);
          other.setAttribute('aria-pressed', String(active));
        }
        apply();
      });
    }

    hotChip?.addEventListener('click', () => {
      hotOnly = !hotOnly;
      hotChip.classList.toggle('is-active', hotOnly);
      hotChip.setAttribute('aria-pressed', String(hotOnly));
      apply();
    });

    reset?.addEventListener('click', () => {
      input.value = '';
      kind = 'all';
      hotOnly = false;
      for (const chip of kindChips) {
        const active = chip.dataset.kind === 'all';
        chip.classList.toggle('is-active', active);
        chip.setAttribute('aria-pressed', String(active));
      }
      if (hotChip) {
        hotChip.classList.remove('is-active');
        hotChip.setAttribute('aria-pressed', 'false');
      }
      apply();
    });

    input.addEventListener('input', apply);
  }
</script>
